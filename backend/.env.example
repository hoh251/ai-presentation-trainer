# Copy to backend/.env. Never commit the populated file.
TRAINER_TEST_MODE=false
GEMINI_API_KEY=
# Set model IDs available to your account. No model name is silently substituted.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
MODEL_PACKAGE_MODULE=model_package
MODEL_LOADER=auto
# MODEL_BASE_PATH=C:/private/base-model
# MODEL_CHECKPOINT_DIR=C:/private/checkpoint
# MODEL_MANIFEST_PATH=C:/path/to/model_package/manifest.json
# MODEL_AGENT_GATES_PATH=C:/private/calibrated-agent-gates.json
# MODEL_ARTIFACT_DIR=C:/absolute/path/to/artifacts
# TRAINER_STORAGE=C:/absolute/path/to/backend/storage
REQUEST_DEADLINE_SECONDS=115
PROVIDER_TIMEOUT_SECONDS=35
GENERATION_TRIES=2
GEMINI_GENERATION_RPM=12
GEMINI_EMBEDDING_RPM=60
GEMINI_PROVIDER_RETRIES=1
GEMINI_MAX_BACKOFF_SECONDS=3
GEMINI_EMBEDDING_BATCH_SIZE=16
QUESTION_DEDUP_THRESHOLD=0.92
