# Copy to backend/.env. Never commit the populated file.
TRAINER_TEST_MODE=false
GEMINI_API_KEY=
# Set model IDs available to your account. No model name is silently substituted.
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
MODEL_PACKAGE_MODULE=model_package
# MODEL_ARTIFACT_DIR=C:/absolute/path/to/artifacts
# TRAINER_STORAGE=C:/absolute/path/to/backend/storage
REQUEST_DEADLINE_SECONDS=115
PROVIDER_TIMEOUT_SECONDS=35
GENERATION_TRIES=2
